# Local development (npm run dev). Copy to .env.local.

# From the stack outputs: npm run deploy:infra prints them, or
#   aws cloudformation describe-stacks --stack-name admin-3s --region eu-north-1
COGNITO_USER_POOL_ID=eu-north-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# One pair per site you want to edit locally: the site's repo, and where its dev server runs.
LOCAL_SITE_KONARK=../konark-digital-academy
LOCAL_SITE_KONARK_URL=http://localhost:8081
